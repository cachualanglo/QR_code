# ============================================
# 🐳 Docker Compose — Environment Variables
# Copy this file to .env and fill in the values
# ============================================

# ─── Database ────────────────────────────────
POSTGRES_DB=attendance_db
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────
REDIS_PORT=6379

# ─── Backend (Spring Boot) ───────────────────
BACKEND_PORT=8080
JWT_SECRET=your_jwt_secret_min_32_chars_long
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ─── Company Location (GPS) ─────────────────
COMPANY_LAT=20.9926562
COMPANY_LNG=105.8439679
COMPANY_RADIUS_METERS=80

# ─── Frontend ────────────────────────────────
DOCKER_FRONTEND_PORT=3000

# ─── TLS / SSL (optional for local dev) ──────
# SERVER_SSL_ENABLED=false
# SERVER_SSL_KEYSTORE=classpath:keystore.p12
# SERVER_SSL_KEYSTORE_PASSWORD=changeit
# SERVER_SSL_KEY_ALIAS=attendance
